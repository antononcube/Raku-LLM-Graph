use v6.d;
use Test;

#use lib <. lib>;
use LLM::Graph;
use Graph;
use LLM::Functions;

plan *;

subtest {
    my %rules =
            poet1 => {
                eval-function => { start {sleep 0.1;'out1'} }
            },
            poet2 => {
                eval-function => { start {sleep 0.1;'out2'} }
            },
            judge => {
                eval-function => sub ($poet1, $poet2) { start "$poet1 : $poet2"}
            };

    ## 1
    ok LLM::Graph.new(%rules):async;

    ## 2
    my $g = LLM::Graph.new(%rules):async;
    isa-ok $g.create-graph.graph, Graph:D, 'got graph';

    ## 3
    is $g.eval.nodes<judge><result>, 'out1 : out2', 'got judgemet';

    ## 4
    is
            $g.eval.nodes<poet1 poet2>.map(*<result>).all ~~ Promise:D,
            True,
            'All poets of promises';

}, 'ad-hoc Promise functions (no-LLM)';

subtest {
    my %rules =
            inputs => {
                eval-function => { [1, 2, 3] }
            },
            doubled => {
                listable-llm-function => sub ($inputs) {
                    sleep 0.01 * (4 - $inputs);
                    $inputs * 2
                }
            };

    my $g = LLM::Graph.new(%rules):async;

    is-deeply
            $g.eval.nodes<doubled><result>,
            [2, 4, 6],
            'listable function evaluates a node list concurrently and preserves order';

}, 'listable function with a node input';

subtest {
    my %rules =
            transformed => {
                listable-llm-function => sub ($value) {
                    start {
                        sleep 0.01 * (4 - $value);
                        $value + 10
                    }
                }
            },
            result => {
                eval-function => sub ($transformed) {
                    $transformed
                }
            }
            ;

    my $g = LLM::Graph.new(%rules):async;

    is-deeply
            $g.eval([1, 2, 3]).nodes<result><result>,
            [11, 12, 13],
            'a list positional argument is threaded and nested Promises are resolved';

}, 'listable function with a positional input';

done-testing;
